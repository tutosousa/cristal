DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=cristal_floricultura
DB_SSL=false
PORT=5000
JWT_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria
JWT_EXPIRES_IN=8h
CUSTOMER_JWT_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5000

# Mercado Pago (checkout invisível) — veja a seção 7 do README
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# E-mail transacional (cadastro, 2FA, recuperação de senha, avisos de pedido)
# — veja a seção 7.1 do README. Deixe tudo em branco para rodar em modo
# simulado (os códigos aparecem na própria tela).
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cristal Floricultura <seuemail@gmail.com>
EMAIL_ADMIN=

# Melhor Envio (frete para pedidos sem flores) — só é usado quando o
# carrinho não tem nenhum produto com possui_flores = 1
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_ACESSS_TOKEN=
MELHOR_ENVIO_CEP_ORIGEM=

# Cloudinary (armazenamento das fotos em produção/Vercel — o disco da Vercel
# não guarda arquivos). Deixe em branco para salvar no disco local (dev).
# Pegue em cloudinary.com > Dashboard > API Keys (use a variável única OU as três).
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
